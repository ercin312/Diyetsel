rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function authEmail() {
      return signedIn() && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : '';
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(uid()));
    }

    function hasUserDoc() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(uid()));
    }

    function isAdmin() {
      return signedIn() && (
        (hasUserDoc() && userDoc().data.role == 'admin')
        || authEmail() == 'diyetisyen@diyetsel.app'
      );
    }

    function legacyId() {
      return hasUserDoc() && 'legacyId' in userDoc().data
        ? userDoc().data.legacyId
        : uid();
    }

    function isSelf(userId) {
      return signedIn() && (
        uid() == userId
        || legacyId() == userId
        || (userId == 'client-demo' && authEmail() == 'danisan@diyetsel.app')
        || (userId == 'client-elif' && authEmail() == 'elif@diyetsel.app')
        || (userId == 'admin-demo' && authEmail() == 'diyetisyen@diyetsel.app')
      );
    }

    function ownsClient(clientId) {
      return isSelf(clientId);
    }

    // Clinic shared read: one practice, all signed-in members can see clinic data.
    // Writes stay role/owner scoped.

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && (isSelf(userId) || isAdmin());
      allow update: if isAdmin()
        || (isSelf(userId) && (!('role' in request.resource.data)
            || request.resource.data.role == resource.data.role));
      // Self-delete required for App Store Guideline 5.1.1(v).
      allow delete: if isAdmin() || isSelf(userId);
    }

    match /appointments/{id} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isAdmin() || ownsClient(resource.data.clientId);
    }

    match /availability/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /services/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /serviceRequests/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && ownsClient(request.resource.data.clientId);
      allow update, delete: if isAdmin() || ownsClient(resource.data.clientId);
    }

    match /dietPlans/{id} {
      allow read: if signedIn();
      allow create: if isAdmin();
      allow update: if isAdmin() || ownsClient(resource.data.clientId);
      allow delete: if isAdmin() || ownsClient(resource.data.clientId);
    }

    match /waterLogs/{id} {
      allow read: if signedIn();
      allow write: if isAdmin()
        || (signedIn() && ownsClient(request.resource.data.userId));
    }

    match /measurements/{id} {
      allow read: if signedIn();
      allow write: if isAdmin()
        || (signedIn() && ownsClient(request.resource.data.userId));
    }

    match /mealLogs/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && ownsClient(request.resource.data.clientId);
      allow update, delete: if isAdmin() || ownsClient(resource.data.clientId);
    }

    match /blogPosts/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /blogInteractions/{id} {
      allow read, write: if signedIn();
    }

    match /recipes/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /recipeInteractions/{id} {
      allow read, write: if signedIn();
    }

    match /chats/{id} {
      allow read, write: if signedIn();
    }

    match /messages/{id} {
      allow read, write: if signedIn();
    }

    match /documents/{id} {
      allow read: if signedIn();
      allow write: if isAdmin()
        || (signedIn() && ownsClient(request.resource.data.userId));
    }

    match /payments/{id} {
      allow read: if signedIn();
      allow create, update: if isAdmin();
      allow delete: if isAdmin() || ownsClient(resource.data.clientId);
    }

    match /shoppingLists/{id} {
      allow read: if signedIn();
      allow write: if isAdmin() || isSelf(id)
        || (signedIn() && ownsClient(request.resource.data.userId));
    }

    match /prefs/{id} {
      allow read, write: if isAdmin() || isSelf(id);
    }

    match /streaks/{id} {
      allow read: if signedIn();
      allow write: if isAdmin() || isSelf(id)
        || (signedIn() && ownsClient(request.resource.data.userId));
    }

    match /checkIns/{id} {
      allow read: if signedIn();
      allow write: if isAdmin()
        || (signedIn() && ownsClient(request.resource.data.userId));
    }

    match /fasting/{id} {
      allow read: if signedIn();
      allow write: if isAdmin() || isSelf(id)
        || (signedIn() && ownsClient(request.resource.data.userId));
    }

    match /userProgress/{id} {
      allow read: if signedIn();
      allow write: if isAdmin() || isSelf(id);
    }

    match /adminBroadcasts/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /home_theme/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
